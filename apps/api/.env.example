NODE_ENV=development
PORT=4000
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/myfinance
TEST_DATABASE_URL=postgresql://postgres:postgres@localhost:5432/myfinance_test
# Use openssl rand -hex 32
JWT_SECRET=change-me-at-least-32-chars-long
REFRESH_TOKEN_SECRET=change-me-at-least-32-chars-long
PAN_HMAC_SECRET=change-me-at-least-32-chars-long
CORS_ORIGIN=http://localhost:5173
# Serves Swagger UI at /api/docs. Keep false in production unless intentionally exposed.
API_DOCS_ENABLED=true
# Setu API credentials. Get these from Setu dashboard.
SETU_BASE_URL=https://dg-sandbox.setu.co
SETU_CLIENT_ID=your-setu-client-id
SETU_CLIENT_SECRET=your-setu-client-secret
SETU_PRODUCT_INSTANCE_ID=your-setu-product-instance-id
