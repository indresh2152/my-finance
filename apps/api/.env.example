NODE_ENV=development
PORT=4000
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/myfinance
TEST_DATABASE_URL=postgresql://postgres:postgres@localhost:5432/myfinance_test
# Use openssl rand -hex 32
JWT_SECRET=change-me-at-least-32-chars-long
REFRESH_TOKEN_SECRET=change-me-at-least-32-chars-long
PAN_HMAC_SECRET=change-me-at-least-32-chars-long
CORS_ORIGIN=http://localhost:5173
# Serves Swagger UI at /api/docs. Keep false in production unless intentionally exposed.
API_DOCS_ENABLED=true
# Setu API credentials. Get these from Setu dashboard.
SETU_BASE_URL=https://dg-sandbox.setu.co
SETU_CLIENT_ID=your-setu-client-id
SETU_CLIENT_SECRET=your-setu-client-secret
SETU_PRODUCT_INSTANCE_ID=your-setu-product-instance-id
# ── Mailbox integration (Gmail / Outlook) ──────────────────────────────
# Set to true to mount /api/v1/mailboxes and start the pg-boss sync worker.
MAILBOX_ENABLED=false
# Public origin of the SPA. In dev use the Vite origin so the OAuth callback goes through the Vite proxy.
APP_BASE_URL=http://localhost:5173
# Google Cloud console → OAuth client (Web). Redirect URI: ${APP_BASE_URL}/api/v1/mailboxes/oauth/callback/google
GOOGLE_CLIENT_ID=your-google-client-id
GOOGLE_CLIENT_SECRET=your-google-client-secret
# Optional (leave both blank to disable Outlook). Entra ID app registration (multi-tenant + personal). Redirect URI: ${APP_BASE_URL}/api/v1/mailboxes/oauth/callback/microsoft
MICROSOFT_CLIENT_ID=your-microsoft-client-id
MICROSOFT_CLIENT_SECRET=your-microsoft-client-secret
# Comma-separated version:hexkey pairs; each key is 32 bytes (openssl rand -hex 32).
MAIL_CREDENTIAL_ENC_KEYS=1:change-me-64-hex-chars
MAIL_CREDENTIAL_ENC_ACTIVE_VERSION=1
# HMAC secret for mailbox email uniqueness (openssl rand -hex 32)
EMAIL_HMAC_SECRET=change-me-at-least-32-chars-long
# Background sync schedule (cron)
MAIL_SYNC_CRON=0 */6 * * *
